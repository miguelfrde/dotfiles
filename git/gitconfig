[core]
    quotepath = false
    excludesfile = ~/.gitignore
    editor = /opt/homebrew/bin/nvim
    autocrlf = input
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    followTags = true
[fetch]
    prune = true
[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true
[rerere]
    enabled = true
    autoUpdate = true
[diff]
    algorithm = histogram
    colorMoved = default
[alias]
    ci = commit
    co = checkout
    g = grep --break --heading --line-number
    hist = log --oneline --graph
    d = difftool
[web]
    browser = google-chrome
[browser "google-chrome"]
    path = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[color]
    ui = true
[color "diff"]
    meta = yellow
    frag = magenta
    old = red
    new = green
    whitespace = white reverse
[color "status"]
    added = yellow
    changed = white
    untracked = red
    branch = magenta
[color "branch"]
    current = yellow
    local = green
    remote = magenta
[credential]
    helper = osxkeychain
[grep]
    patternType = extended
    lineNumber = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    required = true
    process = git-lfs filter-process
[merge]
    tool = opendiff
    conflictStyle = zdiff3
[mergetool]
    keepBackup = false
    prompt = false
[difftool]
    prompt = false
[commit]
    gpgsign = true
[tag]
    gpgSign = true
