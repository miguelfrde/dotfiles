[core]
    quotepath = false
    excludesfile = ~/.gitignore
    editor = /opt/homebrew/bin/nvim
    autocrlf = input
[alias]
    ci = commit
    co = checkout
    g = grep --break --heading --line-number
    hist = log --oneline --graph
    d = difftool
[web]
    browser = google-chrome
[color]
    ui = true
[color "diff"]
    meta = yellow
    frag = magenta
    old = red
    new = green
    whitespace = white reverse
[color "status"]
    added = yellow
    changed = white
    untracked = red
    branch = magenta
[color "branch"]
    current = yellow
    local = green
    remote = magenta
[hub]
    protocol = https
[credential]
    helper = osxkeychain
[grep]
    extendRegexp = true
    lineNumber = true
[filter "lfs"]
    clean = git-lfs clean %f
    smudge = git-lfs smudge %f
    required = true
[merge]
    tool = opendiff
[difftool]
    prompt = false
[commit]
    gpgsign = true
[gpg]
    program = gpg
