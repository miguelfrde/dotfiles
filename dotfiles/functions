# Update OSX
function update_osx() {
    echo "Find Apple software updates"
    sudo softwareupdate -i -a
}

# Create a new directory and cd into it
function mkd() {
    mkdir -p "$1" && cd "$1"
}

# replace_in_files <original> <replacement> [path ...]
# The search is literal; sed still reads <original> as a basic regex and
# <replacement> as a sed replacement (`&`, `\`, `|` keep their meaning).
function replace_in_files() {
    local original=$1 replacement=$2
    shift 2
    rg -l0 -F -- "$original" "$@" | xargs -0 sed -i '' "s|$original|$replacement|g"
}
