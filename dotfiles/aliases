# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias -- -="cd -"

# Like ls -la, but with directories first
alias ll='tree --dirsfirst -ChFupDaLg 1'

# Grep with colored matches
alias grep='grep --color=auto'

# View current IP
alias ip='curl -s https://api.ipify.org'

# View local IP
alias localip="ipconfig getifaddr en0"

# View size of current directory
alias d="du -h -d 1"

# Used to connect to Raspberry Pi
alias rpi='ssh 192.168.1.10 -l pi'

# rc files
alias zshrc='nvim ~/.zshrc'
alias vimrc='nvim ~/.config/nvim/lua/config/vimrc.lua'

# Use neovim
alias vim=nvim

alias weather="curl http://wttr.in"
