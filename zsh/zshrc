# Keep PATH free of duplicates: nested shells re-source this file and
# .zprofile's brew shellenv, and every prepend below would stack otherwise.
typeset -U path PATH

# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh

source ~/.exports

# zsh syntax highlighting
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# oh-my-zsh plugins
plugins=(brew git pip python gh docker)

# Theme to load
ZSH_THEME="miguelfrde"

# Zsh-syntax-highlighting plugin
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets cursor)

# Uncomment the following line to use hyphen-insensitive completion. Case
# sensitive completion must be off. _ and - will be interchangeable.
HYPHEN_INSENSITIVE="true"

source $ZSH/oh-my-zsh.sh
source ~/.aliases
source ~/.functions

# Option-Arrow to move through words in the CLI. Ghostty sends ESC-b / ESC-f,
# which the emacs keymap already binds; these cover terminals that send the
# CSI form instead.
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word

# CTRL Z nice
fancy-ctrl-z() {
  if [[ $#BUFFER -eq 0 ]]; then
    BUFFER="fg"
    zle accept-line
  else
    zle push-input
    zle clear-screen
  fi
}

zle -N fancy-ctrl-z
bindkey '^Z' fancy-ctrl-z

# added by fzf
[ -t 0 ] && [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Cargo
source "$HOME/.cargo/env"

# Ruby stuff
source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/chruby/share/chruby/chruby.sh"
source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/chruby/share/chruby/auto.sh"

# Pyenv stuff. --no-rehash skips the slow `pyenv rehash` on every start; run it
# by hand after `pip install` of a package with console scripts or `pyenv uninstall`.
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - --no-rehash zsh)"

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"

# Added by Antigravity
export PATH="/Users/miguel/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Added by Antigravity IDE
export PATH="/Users/miguel/.antigravity-ide/antigravity-ide/bin:$PATH"
